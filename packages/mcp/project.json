{
  "name": "mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/mcp/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["mcp-ui"], "target": "build" }],
      "options": {
        "commands": [
          {
            "command": "nx run gcpd-api:dev"
          },
          {
            "command": "nx run mcp-ui:dev"
          },
          {
            "command": "tsx watch src/index.ts"
          },
          {
            "command": "pnpm inspect"
          }
        ],
        "parallel": true,
        "cwd": "{projectRoot}"
      }
    }
  }
}
