{
  "name": "mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/mcp/src",
  "targets": {
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": [
        { "projects": ["mcp-ui"], "target": "build" },
        { "projects": ["gcpd-api"], "target": "dev" },
        {
          "target": "inspect"
        }
      ],
      "options": {
        "command": "tsx watch src/index.ts",
        "cwd": "packages/mcp"
      }
    },
    "inspect": {
      "continuous": true
    }
  }
}
