{
  "Mcp Server": {
    "scope": "javascript,typescript",
    "prefix": "--demo-mcp",
    "body": "export const mcpServer = new McpServer($0);",
    "include": ["**/demo/mcp-server.ts"],
  },
  "Mcp Server - description": {
    "scope": "javascript,typescript",
    "prefix": "--demo-descr",
    "body": "'GCPD Mcp Server listing criminals and crimes for any city'",
    "include": ["**/demo/mcp-server.ts"],
  },
  "Mcp Server - handler": {
    "scope": "javascript,typescript",
    "prefix": "--demo-handler",
    "body": ["httpServer.post('${1:/mcp}', async (req, res) => {", "\n  $2\n", "  res.raw.on('close', () => {", "  });", "})"],
    "include": ["**/demo/mcp-server.ts"],
  },
  "criminal-tools": {
    "scope": "javascript,typescript",
    "prefix": "--demo-tool-output",
    "body": [
      "z.object({",
      "\tname: z.string().describe('The name of the criminal'),",
      "\tpicture: z.url().nullable().describe('The official GCPD picture of the criminal'),",
      "\tdetails: z.object({",
      "\t\trealName: z.string().nullable().describe('The real name of the criminal'),",
      "\t\taliases: z.array(z.string()).describe('All known aliases of the criminal'),",
      "\t\trelatives: z.array(z.string()).describe('All known friend and family of the criminal'),",
      "\t\tcitizenship: z.string().nullable().describe('The nationality of the criminal'),",
      "\t\tgender: z.string().nullable().describe('The gender of the criminal'),",
      "\t\theight: z.string().nullable().describe('The heigh in feet of the criminal'),",
      "\t\tweight: z.string().nullable().describe('The weight in lbs of the criminal'),",
      "\t\teyes: z.string().nullable().describe('The color of eyes of the criminal'),",
      "\t\thair: z.string().nullable().describe('The color of the hair of the criminal'),",
      "\t\taffiliation: z.array(z.string()).describe('All known affiliation'),",
      "\t}).nullable().describe('Additional information of the criminal'),",
      "}),",
    ],
    "include": ["**/demo/01-criminal-tools.ts"],
  },
  "criminal-tools description": {
    "scope": "javascript,typescript",
    "prefix": "--demo-tool-descr",
    "body": ["'Get the list of all criminals from the GCPD database.'"],
    "include": ["**/demo/01-criminal-tools.ts"],
  },
  "criminal-tools return": {
    "scope": "javascript,typescript",
    "prefix": "--demo-tool-return-content",
    "body": ["content: [{ type: 'text', text: $2 }],"],
    "include": ["**/demo/01-criminal-tools.ts"],
  },
  "criminal-tools meta": {
    "scope": "javascript,typescript",
    "prefix": "--demo-tool-meta",
    "body": ["_meta: {", "\tui: {", "\t\tresourceUri: 'ui://get_criminals',", "\t},", "},"],
    "include": ["**/demo/01-criminal-tools.ts"],
  },
  "criminal-tools - ressource": {
    "scope": "javascript,typescript",
    "prefix": "--demo-tool-ressource-ui",
    "body": [
      "mcpServer.registerResource(",
      "  'Get Criminal UI',",
      "  'ui://get_criminals',",
      "  {",
      "    mimeType: 'text/html;profile=mcp-app',",
      "  },",
      "  async () => {",
      "    const html = await resolveDistFiles('src/criminals/index.html');",
      "",
      "    return {",
      "      contents: [",
      "        {",
      "          uri: 'ui://get_criminals',",
      "          mimeType: 'text/html;profile=mcp-app',",
      "          text: html,",
      "        },",
      "      ],",
      "    };",
      "  },",
      ");",
    ],
    "include": ["**/demo/01-criminal-tools.ts"],
  },
  "criminal-tools ui": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "--demo-app",
    "body": ["const app = new App({ name: '$1', version: '$2' });"],
    "include": ["**/demo/criminals.tsx"],
  },
  "criminal-tools handler": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "--demo-handler",
    "body": ["const criminals = data.structuredContent?.criminals as Criminal[];"],
    "include": ["**/demo/criminals.tsx"],
  },
  "criminal-tools react": {
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "prefix": "--demo-react",
    "body": ["createRoot(document.getElementById('root')!).render($1);"],
    "include": ["**/demo/criminals.tsx"],
  },
  "criminal-tools - csp": {
    "scope": "javascript,typescript",
    "prefix": "--demo-tool-csp",
    "body": [
        "_meta: {",
        "  ui: {",
        "    csp: {",
        "           resourceDomains: [process.env.MCP_ORIGIN, 'https://static.wikia.nocookie.net'],",
        "         },",
        "  },",
        "},",
    ],
    "include": ["**/demo/01-criminal-tools.ts"],
  },
}
